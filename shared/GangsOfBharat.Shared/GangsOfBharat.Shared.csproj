<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity-compatible game core. Unity consumes the .cs files in this folder as source,
    so the language level is pinned to C# 9 and nullable annotations are off.
    Do not add PackageReferences: the code must build offline and inside Unity.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>GangsOfBharat.Shared</RootNamespace>
    <AssemblyName>GangsOfBharat.Shared</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
